# Copy to .env — these values are for running services from the IDE against `make up-infra`
# (backing services only). The compose `full` profile sets its own service environment and does
# not read this file.
SELLOUT_DB_URL=jdbc:postgresql://localhost:5432/sellout
SELLOUT_DB_USER=sellout
SELLOUT_DB_PASSWORD=sellout
SELLOUT_REDIS_URL=redis://localhost:6379
SELLOUT_KAFKA_BOOTSTRAP=localhost:29092
SELLOUT_OIDC_ISSUER=http://localhost:8180/realms/sellout
SELLOUT_OIDC_AUDIENCE=sellout-api
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_PASSWORD=admin
